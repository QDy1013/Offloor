<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件：今天的课 + 最近的待办。行由代码按 widget_row 逐条加入。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/w_course_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/w_course_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="课程"
            android:textColor="@color/widget_mute"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/w_courses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/w_course_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="3dp"
            android:textColor="@color/widget_sub"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_todo_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/w_todo_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="待办"
            android:textColor="@color/widget_mute"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/w_todos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/w_todo_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="3dp"
            android:textColor="@color/widget_sub"
            android:textSize="13sp"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
